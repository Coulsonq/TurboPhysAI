+// Bind a second communicator before any graph executor is registered. Parameter
+// all-gather keeps the original communicator, while gradient reduce-scatter uses
+// the rank order of Turbo's existing independent gradient process group.
+void set_reduce_process_group(c10::intrusive_ptr<c10d::ProcessGroup> pg)
+{
+    TORCH_CHECK(process_group != nullptr, "DeepCompile must be initialized first");
+    TORCH_CHECK(pg != nullptr, "gradient process group must not be null");
+    TORCH_CHECK(executors.empty(), "set gradient group before compiling graphs");
+    TORCH_CHECK(reduce_nccl_comm == nullptr, "gradient group already initialized");
+    TORCH_CHECK(pg->getSize() == process_group->getSize() &&
+                pg->getRank() == process_group->getRank(), "gradient rank order mismatch");
+    ncclUniqueId id;
+    TORCH_CHECK(ncclGetUniqueId(&id) == ncclSuccess, "gradient communicator id failed");
+    auto bytes = torch::from_blob(&id, {NCCL_UNIQUE_ID_BYTES}, torch::kUInt8)
+                     .to(torch::Device(torch::kCUDA));
+    std::vector<at::Tensor> inputs = {bytes};
+    pg->broadcast(inputs, c10d::BroadcastOptions())->wait();
+    auto host_bytes = bytes.to(torch::Device(torch::kCPU));
+    std::memcpy(&id, host_bytes.data_ptr(), NCCL_UNIQUE_ID_BYTES);
+    ncclComm_t comm = nullptr;
+    auto status = ncclCommInitRank(&comm, pg->getSize(), id, pg->getRank());
+    if (status != ncclSuccess) {
+        if (comm != nullptr) { ncclCommAbort(comm); }
+        TORCH_CHECK(false, "gradient communicator init failed: ", ncclGetErrorString(status));
+    }
+    reduce_process_group = std::move(pg);
+    reduce_nccl_comm = comm;
+}
+
+std::string get_reduce_group_name()
+{
+    return reduce_process_group ? reduce_process_group->getGroupName() : std::string();
+}
